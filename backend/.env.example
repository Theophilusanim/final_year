# Allowed subnets in CIDR format (comma-separated).
# 127.0.0.1/32 and ::1/128 allow local loopback testing.
# Add your campus/office network range here, e.g., 192.168.1.0/24
ALLOWED_SUBNETS="127.0.0.1/32,::1/128,192.168.1.0/24"

# Authentication. Use a long random JWT secret and a unique initial password.
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_MINUTES="60"
ADMIN_EMAIL="admin@aegis.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Shift start time configuration (HH:MM format).
# Check-ins up to 08:00 AM are marked "Present".
# Check-ins from 08:01 AM onwards are marked "Late".
WORK_START_TIME="08:00"

# Facial recognition cosine similarity threshold (default 0.70)
MATCH_THRESHOLD="0.70"

# Database Connection URL
# Defaults to persistent SQLite database at backend/attendance.db if left unset.
# Examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/attendance_db
#   SQLite absolute path: sqlite:///c:/Users/Theophelous/anaconda3/envs/PROJECT FILES/backend/attendance.db
DATABASE_URL="sqlite:///c:/Users/Theophelous/anaconda3/envs/PROJECT FILES/backend/attendance.db"

