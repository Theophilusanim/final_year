# Allowed subnets in CIDR format (comma-separated).
# 127.0.0.1/32 and ::1/128 allow local loopback testing.
# Add your campus/office network range here, e.g., 192.168.1.0/24
ALLOWED_SUBNETS="127.0.0.1/32,::1/128,192.168.1.0/24"

# Shift start time configuration (HH:MM format).
# Check-ins up to 08:00 AM are marked "Present".
# Check-ins from 08:01 AM onwards are marked "Late".
WORK_START_TIME="08:00"

# Facial recognition cosine similarity threshold (default 0.70)
MATCH_THRESHOLD="0.70"
